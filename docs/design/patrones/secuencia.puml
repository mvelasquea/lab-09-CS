@startuml secuencia
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
title solicitar_cita() después del refactor: los patrones colaborando
autonumber
participant "ServicioCitas" as S
participant "Eslabon\n<<Chain>>" as V
participant "FabricaAgendas\n<<Factory>>" as F
participant "ConReintentos\n<<Decorator>>" as D
participant "ClinicaAdapter\n<<Adapter>>" as A
participant "MasProximo\n<<Strategy>>" as P
participant "Cita\n+ estado <<State>>" as C
participant "PublicadorEventos\n<<Observer>>" as O
participant "NotificadorWhatsApp" as W
participant "ProgramadorRecordatorios" as R

S -> V : procesar(cita)
V --> S : ok (estado, DNI, celular, especialidad, límite)
S -> F : crear("CLINICA")
F --> S : ConReintentos(ClinicaAdapter)
S -> D : cupos_disponibles(especialidad)
D -> A : cupos_disponibles(especialidad)
A --> S : [Cupo, ...]
S -> P : elegir(cupos, cita)
P --> S : Cupo
S -> D : reservar(cupo, dni)
loop hasta 3 intentos si hay TimeoutError
  D -> A : reservar(cupo, dni)
  A --> D : ResultadoReserva
end
D --> S : ResultadoReserva(confirmada)
alt confirmada
  S -> C : confirmar(cupo, codigo)
  note right of C : Solicitada -> Confirmada
  S -> O : publicar("cita_confirmada", datos)
  O -> W : actualizar(...)
  O -> R : actualizar(...)
else rechazada
  S -> C : cancelar()
  note right of C : Solicitada -> Cancelada
end
@enduml
